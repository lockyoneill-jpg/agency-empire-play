{
  "appId": "digital.studioden.agencyempire",
  "appName": "Idle Estate Agent",
  "webDir": "www",
  "backgroundColor": "#051f3f",
  "ios": {
    "contentInset": "never",
    "allowsLinkPreview": false,
    "scrollEnabled": false,
    "backgroundColor": "#051f3f",
    "preferredContentMode": "mobile"
  },
  "android": {
    "backgroundColor": "#051f3f",
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#051f3f",
      "showSpinner": false,
      "launchShowDuration": 0
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#051f3f",
      "overlaysWebView": true
    }
  }
}
